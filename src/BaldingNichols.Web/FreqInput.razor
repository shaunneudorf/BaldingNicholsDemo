@using System.Globalization

<div class="field">
    <label>
        <span class="field-label">@Label</span>
        <input type="number" step="any" min="0" max="1"
               value="@(Value is double v ? Fmt.Plain(v) : "")"
               disabled="@Disabled"
               @onchange="Changed" />
    </label>
    @if (Note.Length > 0 || Edited)
    {
        <p class="source">
            @Note
            @if (Edited)
            {
                <button type="button" class="link" @onclick="() => OnReset.InvokeAsync()">Use database value</button>
            }
        </p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public double? Value { get; set; }
    [Parameter] public string Note { get; set; } = "";
    [Parameter] public bool Edited { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<double?> OnValue { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task Changed(ChangeEventArgs e) =>
        OnValue.InvokeAsync(
            double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var d) ? d : null);
}
